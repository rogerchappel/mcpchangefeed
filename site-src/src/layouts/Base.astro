---
type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <slot name="head" />
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #0c1117;
        --muted: #5b6675;
        --soft: #7a8494;
        --line: #d8dee8;
        --line-strong: #b8c2d1;
        --paper: #ffffff;
        --panel: #ffffff;
        --panel-soft: #f6f8fb;
        --night: #101820;
        --night-2: #17212d;
        --accent: #0f766e;
        --accent-strong: #0b4f4a;
        --blue: #2563eb;
        --green: #15803d;
        --amber: #b45309;
        --rose: #be123c;
        --shadow: 0 18px 50px rgb(16 24 32 / 10%);
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--paper);
      }

      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background: var(--paper);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:hover {
        color: var(--accent);
      }

      code {
        display: inline-block;
        max-width: 100%;
        overflow-wrap: anywhere;
        border: 1px solid var(--line);
        border-radius: 7px;
        background: #f3f6fa;
        padding: 0.2rem 0.42rem;
        color: #14202b;
        font-size: 0.9em;
      }

      .site-shell {
        min-height: 100vh;
        background:
          linear-gradient(180deg, #f7f9fc 0, #fff 360px),
          #fff;
      }

      .nav-frame {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid rgb(255 255 255 / 9%);
        background: rgb(16 24 32 / 94%);
        color: #fff;
        backdrop-filter: blur(18px);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 14px 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #fff;
        font-weight: 850;
      }

      .brand-mark {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border: 1px solid rgb(255 255 255 / 18%);
        border-radius: 8px;
        color: #d6fffb;
        background: linear-gradient(135deg, #0f766e, #162132);
        font-size: 13px;
        letter-spacing: 0;
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        color: #cbd5e1;
        font-size: 0.92rem;
      }

      .nav-links a {
        border-radius: 7px;
        padding: 8px 10px;
      }

      .nav-links a:hover {
        color: #fff;
        background: rgb(255 255 255 / 8%);
      }

      .wrap {
        width: min(1200px, calc(100% - 40px));
        margin: 0 auto;
      }

      .hero {
        padding: 56px 0 34px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.28fr) minmax(320px, 0.72fr);
        gap: 26px;
        align-items: stretch;
      }

      .hero-copy {
        display: flex;
        min-height: 360px;
        flex-direction: column;
        justify-content: center;
      }

      .compact-hero .hero-copy {
        min-height: 250px;
      }

      .eyebrow {
        margin: 0 0 12px;
        color: var(--accent);
        font-size: 0.76rem;
        font-weight: 850;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        overflow-wrap: anywhere;
      }

      h1 {
        max-width: 850px;
        margin: 0;
        font-size: clamp(2.45rem, 5.6vw, 5.35rem);
        line-height: 0.94;
        letter-spacing: 0;
      }

      .compact-hero h1 {
        font-size: clamp(2.25rem, 4.7vw, 4.35rem);
      }

      h2 {
        margin: 0;
        font-size: clamp(1.5rem, 2.8vw, 2.25rem);
        line-height: 1.05;
        letter-spacing: 0;
      }

      h3 {
        margin: 0;
        font-size: 1rem;
        letter-spacing: 0;
      }

      p {
        line-height: 1.55;
      }

      .lead {
        max-width: 700px;
        margin: 20px 0 0;
        color: var(--muted);
        font-size: 1.12rem;
      }

      .hero-panel,
      .panel,
      .server-card,
      .sponsor,
      .article-card {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
        box-shadow: 0 1px 0 rgb(16 24 32 / 3%);
      }

      .hero-panel {
        display: flex;
        min-height: 360px;
        flex-direction: column;
        justify-content: space-between;
        gap: 18px;
        padding: 18px;
        box-shadow: var(--shadow);
      }

      .compact-hero .hero-panel {
        min-height: 250px;
      }

      .metric-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .metric-grid > div,
      .stat-tile {
        min-height: 96px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel-soft);
        padding: 14px;
      }

      .metric-grid strong,
      .stat-tile strong {
        display: block;
        color: var(--ink);
        font-size: clamp(1.75rem, 4vw, 2.55rem);
        line-height: 1;
      }

      .metric-grid span,
      .stat-tile span {
        display: block;
        margin-top: 8px;
        color: var(--muted);
        font-size: 0.86rem;
        line-height: 1.3;
      }

      .single-metric {
        grid-template-columns: 1fr;
      }

      .search-shell {
        display: flex;
        width: min(760px, 100%);
        min-height: 58px;
        margin-top: 26px;
        overflow: hidden;
        border: 1px solid var(--line-strong);
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 12px 30px rgb(16 24 32 / 9%);
      }

      .search-shell input {
        min-width: 0;
        flex: 1;
        border: 0;
        padding: 0 18px;
        color: var(--ink);
        font: inherit;
        outline: 0;
      }

      .search-shell input::placeholder {
        color: #7a8494;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        border: 1px solid var(--night);
        border-radius: 7px;
        background: var(--night);
        padding: 0 15px;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 780;
        white-space: nowrap;
      }

      .button:hover {
        color: #fff;
        background: #243244;
      }

      .button-light {
        border-color: var(--line);
        background: #fff;
        color: var(--ink);
      }

      .button-light:hover {
        color: var(--ink);
        background: #f3f6fa;
      }

      .search-shell .button {
        margin: 7px;
      }

      .quick-links,
      .pill-row,
      .signal-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .quick-links {
        margin-top: 16px;
      }

      .quick-links a,
      .pill,
      .chip {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: #fff;
        padding: 5px 10px;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 650;
      }

      .quick-links a:hover,
      .pill:hover,
      .chip:hover {
        border-color: var(--accent);
        color: var(--accent-strong);
      }

      .chip-good {
        border-color: #bbf7d0;
        background: #f0fdf4;
        color: var(--green);
      }

      .chip-warn {
        border-color: #fed7aa;
        background: #fff7ed;
        color: var(--amber);
      }

      .band {
        padding: 42px 0;
        border-top: 1px solid var(--line);
      }

      .band-tight {
        padding: 26px 0;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
      }

      .section-head p {
        margin: 8px 0 0;
      }

      .text-link {
        color: var(--accent-strong);
        font-size: 0.92rem;
        font-weight: 750;
      }

      .muted {
        color: var(--muted);
      }

      .soft {
        color: var(--soft);
      }

      .server-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(295px, 1fr));
        gap: 14px;
      }

      .featured-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .server-card {
        display: flex;
        min-height: 230px;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
        padding: 16px;
        transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
      }

      .server-card:hover {
        border-color: var(--line-strong);
        box-shadow: 0 14px 34px rgb(16 24 32 / 10%);
        transform: translateY(-1px);
      }

      .server-card.compact {
        min-height: 154px;
      }

      .server-card__top {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 14px;
      }

      .server-card__title {
        display: inline-block;
        color: var(--ink);
        font-size: 1.05rem;
        font-weight: 850;
        line-height: 1.2;
      }

      .server-card p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 0.93rem;
      }

      .score-badge {
        display: grid;
        width: 66px;
        height: 58px;
        place-items: center;
        border: 1px solid #c6f6ee;
        border-radius: 8px;
        background: #effdfa;
        color: var(--accent-strong);
        text-align: center;
      }

      .score-badge strong {
        font-size: 1.18rem;
        line-height: 1;
      }

      .score-badge span {
        display: block;
        margin-top: 2px;
        font-size: 0.68rem;
        font-weight: 780;
        text-transform: uppercase;
      }

      .server-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
        color: var(--soft);
        font-size: 0.82rem;
      }

      .install-line {
        width: 100%;
      }

      .sponsor {
        display: flex;
        flex-direction: column;
        gap: 16px;
        justify-content: space-between;
        border-color: #bfdbfe;
        background:
          linear-gradient(135deg, rgb(37 99 235 / 8%), transparent 45%),
          #fff;
        padding: 16px;
      }

      .sponsor p {
        margin: 8px 0 0;
        color: var(--muted);
      }

      .split,
      .detail-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(320px, 0.55fr);
        gap: 18px;
        align-items: start;
      }

      .change-strip {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
      }

      .change-strip > div {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
        padding: 16px;
      }

      .change-strip strong {
        display: block;
        font-size: 2rem;
        line-height: 1;
      }

      .change-strip span {
        display: block;
        margin-top: 8px;
        color: var(--muted);
        font-size: 0.86rem;
      }

      .change-added {
        color: var(--green);
      }

      .change-removed {
        color: var(--rose);
      }

      .change-columns {
        display: grid;
        grid-template-columns: 1.05fr 1fr 0.82fr;
        gap: 16px;
        align-items: start;
      }

      .change-column {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel-soft);
        padding: 14px;
      }

      .change-column h2 {
        margin-bottom: 14px;
        font-size: 1.15rem;
      }

      .stack {
        display: grid;
        gap: 12px;
      }

      .panel {
        padding: 18px;
      }

      .panel h2 {
        margin-bottom: 14px;
        font-size: 1.3rem;
      }

      .panel a {
        color: var(--accent-strong);
        font-weight: 760;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      .install-panel {
        grid-column: 1 / -1;
      }

      .signal-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin: 0;
      }

      .signal-list div {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel-soft);
        padding: 12px;
      }

      .signal-list dt {
        color: var(--soft);
        font-size: 0.76rem;
        font-weight: 760;
        text-transform: uppercase;
      }

      .signal-list dd {
        margin: 6px 0 0;
        font-size: 1.12rem;
        font-weight: 820;
      }

      .article-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .article-card {
        min-height: 210px;
        padding: 16px;
      }

      .article-card p {
        margin: 10px 0 0;
      }

      .empty-state {
        grid-column: 1 / -1;
        border: 1px dashed var(--line-strong);
        border-radius: 8px;
        padding: 24px;
        color: var(--muted);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
      }

      .footer {
        border-top: 1px solid var(--line);
        margin-top: 28px;
        padding: 28px 0 42px;
        color: var(--muted);
        font-size: 0.9rem;
      }

      @media (max-width: 900px) {
        .hero-grid,
        .split,
        .detail-grid,
        .change-columns,
        .featured-grid,
        .article-grid {
          grid-template-columns: 1fr;
        }

        .hero-copy,
        .hero-panel,
        .compact-hero .hero-copy,
        .compact-hero .hero-panel {
          min-height: 0;
        }
      }

      @media (max-width: 640px) {
        .nav {
          align-items: flex-start;
          flex-direction: column;
        }

        .nav-links {
          justify-content: flex-start;
        }

        .wrap {
          width: min(100% - 28px, 1200px);
        }

        .hero {
          padding: 34px 0 24px;
        }

        .search-shell {
          flex-direction: column;
          padding: 7px;
        }

        .search-shell input {
          min-height: 44px;
          padding: 0 11px;
        }

        .search-shell .button {
          margin: 0;
          width: 100%;
        }

        .metric-grid,
        .change-strip,
        .signal-list {
          grid-template-columns: 1fr;
        }

        .metric-grid > div,
        .stat-tile {
          min-height: 86px;
        }

        .section-head {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <div class="site-shell">
      <header class="nav-frame">
        <div class="nav">
          <a class="brand" href="/">
            <span class="brand-mark">MC</span>
            <span>MCP Changefeed</span>
          </a>
          <nav class="nav-links" aria-label="Main navigation">
            <a href="/changes/">Changes</a>
            <a href="/categories/developer-tools/">Categories</a>
            <a href="/blog/">Blog</a>
            <a href="/data/servers.json">Data</a>
          </nav>
        </div>
      </header>
      <slot />
      <footer class="footer">
        <div class="wrap">
          Open data, transparent scoring, and clearly labeled sponsorship slots. Private sponsor contracts and campaign records stay out of the public repo.
        </div>
      </footer>
    </div>
  </body>
</html>
