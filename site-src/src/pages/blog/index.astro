---
import Base from "../../layouts/Base.astro";
---

<Base title="MCP Changefeed blog" description="Launch notes, ecosystem analysis, and MCP server change roundups.">
  <main>
    <section class="hero compact-hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Blog</p>
          <h1>Analysis for a fast-moving MCP ecosystem.</h1>
          <p class="lead">A home for launch notes, weekly registry roundups, category reports, sponsor interviews, and deeper protocol coverage.</p>
        </div>
        <div class="hero-panel">
          <div class="metric-grid">
            <div>
              <strong>MDX</strong>
              <span>ready for posts</span>
            </div>
            <div>
              <strong>RSS</strong>
              <span>planned feed surface</span>
            </div>
          </div>
          <p class="muted">Editorial content can sit beside generated registry pages without turning every server record into hand-authored content.</p>
        </div>
      </div>
    </section>

    <section class="band band-tight">
      <div class="wrap section-head">
        <div>
          <p class="eyebrow">Planned columns</p>
          <h2>Room for useful content, not filler.</h2>
        </div>
      </div>
      <div class="wrap article-grid">
        <article class="article-card">
          <p class="eyebrow">Weekly</p>
          <h3>Registry roundups</h3>
          <p class="muted">New servers, removed packages, fast-rising categories, and notable maintenance changes.</p>
        </article>
        <article class="article-card">
          <p class="eyebrow">Guides</p>
          <h3>Choosing servers</h3>
          <p class="muted">Practical advice on install safety, freshness signals, permissions, and production readiness.</p>
        </article>
        <article class="article-card">
          <p class="eyebrow">Market</p>
          <h3>Sponsor interviews</h3>
          <p class="muted">Clearly labeled vendor content with useful implementation detail and no hidden placement.</p>
        </article>
      </div>
    </section>
  </main>
</Base>
