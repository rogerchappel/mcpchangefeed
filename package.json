{
  "name": "mcpchangefeed",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "private": false,
  "description": "MCP ecosystem changefeed, CLI, and static site for registry diffs and freshness signals.",
  "type": "module",
  "files": [
    "dist-cli",
    "data/latest",
    "docs/RELEASE_READINESS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "changefeed",
    "registry",
    "cli"
  ],
  "homepage": "https://github.com/rogerchappel/mcpchangefeed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/mcpchangefeed.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/mcpchangefeed/issues"
  },
  "license": "MIT",
  "bin": {
    "mcpfeed": "dist-cli/cli.js",
    "mcpchangefeed": "dist-cli/cli.js"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:cli": "tsc -p tsconfig.cli.json && node scripts/fix-cli-shebang.cjs",
    "build:site": "tsx scripts/build-site.ts --input data/latest/servers.json && astro build",
    "dev:site": "tsx scripts/build-site.ts --input data/latest/servers.json && astro dev",
    "refresh": "tsx scripts/refresh.ts --out data/latest/servers.json --history data/history",
    "validate:data": "tsx scripts/validate-data.ts data/latest/servers.json",
    "smoke": "pnpm run smoke:cli",
    "smoke:cli": "pnpm run build:cli && node dist-cli/cli.js search filesystem --input fixtures/servers.json && node dist-cli/cli.js top --input fixtures/servers.json --limit 2 && node dist-cli/cli.js diff --before fixtures/servers-before.json --after fixtures/servers.json",
    "package:smoke": "pnpm run build:cli && node scripts/package-smoke.cjs",
    "test:unit": "tsx --test tests/*.test.ts",
    "test": "pnpm run test:unit && pnpm run check && pnpm run validate:data && pnpm run build:site && pnpm run smoke",
    "release:check": "pnpm run test && pnpm run package:smoke"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "astro": "^6.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "author": "Roger Chappel"
}
